# Copy to .env.local. Both keys are optional.
#
# Without ANTHROPIC_API_KEY the studio runs in offline preview mode: blueprints
# come from keyword matching and the playground returns a notice instead of a
# model reply. Retrieval, code generation and ZIP export work either way.
ANTHROPIC_API_KEY=

# Only read by generated bots, not by this app — listed here so you know the
# generated .env.example expects it. Adds semantic search alongside BM25.
# VOYAGE_API_KEY=
